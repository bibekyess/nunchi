# Copy to .env.local and fill in. Server-only: never prefix these with NEXT_PUBLIC_.
# Each upstream is optional: leave its URL empty and the app reports that task as
# "not configured" on this server.

# Speech-to-text (Speaches, OpenAI-compatible)
SPEACHES_BASE_URL=https://kosaf.neoali.com/v1
SPEACHES_MODEL=Systran/faster-whisper-large-v3
SPEACHES_API_KEY=            # optional, sent as Bearer if set

# LLM (OpenAI-compatible Qwen on vLLM). LLM_BASE_URL and LLM_MODEL are set together.
LLM_BASE_URL=https://<qwen-host>/v1
LLM_MODEL=
LLM_API_KEY=                 # optional; "none" is sent when empty
LLM_HEADER_NAME=             # custom auth header name
LLM_HEADER_VALUE=            # custom auth header value

# App
APP_ACCESS_TOKEN=            # optional shared passcode protecting /api/* when deployed publicly
# LOG_LEVEL=info             # debug | info | warn | error (default info, debug in development)
# LOG_FORMAT=json            # json | pretty (default json in production, pretty otherwise)
